# cp .env.example .env  e compila. .env non va in git.
#
# Questo file serve SOLO all'interpolazione di docker-compose: nessun servizio
# lo riceve per intero. Ogni container ottiene le variabili elencate una per
# una nel suo blocco `environment:`. E' cosi che LibreChat non vede la chiave
# del modello (decisione 22).

# ---- Host -------------------------------------------------------------
# Sviluppo: *.localhost e risolto a 127.0.0.1 dai browser, senza toccare
# il file hosts. Produzione: i nomi aziendali veri.
APP_HOST=assistente.localhost
SSO_HOST=sso.localhost
REALM=azienda

# ---- Infrastruttura ---------------------------------------------------
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# Radice delle cartelle dei documenti (decisioni 61-64), montata in sola
# lettura nel servizio ingestion. Ogni fonte «cartella» ha un percorso
# relativo a questa radice, es. luis/sicurezza. In produzione: la
# condivisione di rete montata sull host.
CARTELLE_PATH=./cartelle
# INTERVALLO_INDICIZZAZIONE=300        # secondi fra un giro e l altro
# Dove si leggono i documenti. Vuoto: li legge il servizio ingestion, sulla
# GPU della macchina se c'e' posto, altrimenti sul processore.
# Con un server GPU: DOCLING_URL=https://<server>:7443/docling (usa INFERENCE_TOKEN).
# DOCLING_URL=
#
# GPU condivisa con il modello di chat. Regola: di giorno si legge in GPU solo
# se c'e' posto MENTRE il modello e' caricato; il modello di chi sta chattando
# non si scarica mai da soli. Nella finestra notturna si', e l'assistente
# risponde "sto aggiornando l'indice" finche' dura.
# GPU=auto                     # off = sempre sul processore
# VRAM_MINIMA_MB=3500          # sotto questa soglia libera si legge in CPU (picco misurato di Docling: 2,7 GB)
# FINESTRA_NOTTE=22:00-06:00   # vuoto = nessuna finestra, il modello non si tocca mai
# MB_MAX_DI_GIORNO=5           # fuori finestra i file piu' grossi aspettano; 0 = nessun limite
# Server dei modelli, per scaricare quello di chat e far posto a Docling.
# Dal 21/09/2026 e llama-swap (vedi modelli/llama-swap.yaml).
# MODELLI_HOST=host.docker.internal:1235
# MODELLO_CHAT=qwen3-8b-gsq
#
# Descrizione delle immagini estratte dai cataloghi (le rende ricercabili per
# nome). Il VLM sta SEMPRE altrove: in sviluppo Qwen3-VL 4B su LM Studio, in
# produzione il server di inferenza. Se non risponde, il documento entra lo
# stesso senza descrizioni.
# Provati e scartati il 20/09/2026: SmolVLM dentro l'immagine (3,3 GB per dire
# "a few bottles"); glm-ocr (trascrive benissimo, non descrive: niente colori);
# mineru2.5 (descrive ma con token da ripulire e qualche degenerazione);
# granite-vision e Qwen2.5-VL presi da repository generici, inservibili con
# LM Studio (rispondono file di virgole o di punti interrogativi anche al solo
# testo). Regola pratica: prendere i VLM dal catalogo di LM Studio.
# VLM_DESCRIZIONI=api           # api | off
# VLM_URL=http://host.docker.internal:1235/v1
# VLM_MODELLO=qwen/qwen3-vl-4b   # trascrive E descrive (colori, materiali): il solo
#                                # che l'ha fatto bene. glm-ocr trascrive e basta;
#                                # granite-vision e Qwen2.5-VL da repo generici sono
#                                # inservibili con LM Studio (rispondono ??? o ,,,)
# PREZZI_DESCRIZIONI=escludi     # escludi | ammetti (cataloghi fornitore)
# Un file subito, senza aspettare la notte (l'assistente tace per quel tempo):
#   docker compose run --rm ingestion python indicizza.py --forza --solo manuale.pdf

# ---- LibreChat --------------------------------------------------------
# openssl rand -hex 32   (oppure: docker run --rm alpine openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
OPENID_SESSION_SECRET=
CREDS_KEY=                          # 64 caratteri hex (32 byte)
CREDS_IV=                           # 32 caratteri hex (16 byte)

# ---- SSO: LibreChat <-> Keycloak --------------------------------------
OPENID_ISSUER=https://sso.localhost/realms/azienda/.well-known/openid-configuration
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=

# ---- LibreChat <-> orchestratore -------------------------------------
ORCHESTRATOR_KEY=                   # segreto condiviso, rete interna

# ---- Host di inferenza interno ----------------------------------------
# SVILUPPO: llama-swap sulla macchina, FUORI da Docker (dal 21/09/2026; prima
#   era LM Studio sulla 1234). Configurazione in modelli/llama-swap.yaml.
#   I modelli non stanno in un container: su Windows Docker si tiene memoria e
#   GPU e non le restituisce, e la macchina si siede.
#   Verificato: funziona anche in ascolto solo su 127.0.0.1 — Docker Desktop
#   instrada host.docker.internal verso il loopback dell'host. Quindi NON serve
#   esporlo sulla rete locale, ed e' meglio di no: la porta non finisce sulla
#   LAN senza autenticazione.
#   (Comportamento di Docker Desktop, non di Docker su Linux.)
EMBEDDING_URL=http://host.docker.internal:1235/v1
# Id esatto verificato su GET /v1/models — non il nome HuggingFace.
EMBEDDING_MODEL=text-embedding-bge-m3-embeddings
INFERENCE_TOKEN=                        # vuoto in sviluppo: LM Studio non autentica

# PRODUZIONE: host GPU con proxy TLS (docker-compose.inference.yml).
#   EMBEDDING_URL=https://gpu01.azienda.it:7443
#   INFERENCE_TOKEN=<openssl rand -hex 32>

# Allowlist di egress. Il gate consente SOLO questi host: una richiesta verso
# un host non dichiarato e un errore, non un warning. Separati da virgola.
# "Interno" significa dentro il perimetro aziendale, non dentro la macchina.
EGRESS_INTERNAL=host.docker.internal,gpu01.azienda.it,litellm
# Gli host del provider scelto: vietati sui turni contaminati.
EGRESS_EXTERNAL=

# ---- Modelli ----------------------------------------------------------
# Solo il proxy LiteLLM possiede le chiavi dei provider. L'orchestratore
# conosce i modelli per nome logico e non sa di quale provider siano.
LITELLM_MASTER_KEY=                 # openssl rand -hex 32

# MODELLO PRINCIPALE — Qwen3 8B GSQ (configurazione B di GUIDA-MODELLI.md §6:
# 16 GB di VRAM condivisi con Docling e con il VLM). Il 27B resta documentato
# li' per macchine piu' capaci: su questa prendeva 13 GB e bloccava tutto.
# Contesto e parallelismo stanno in modelli/llama-swap.yaml, non qui. Il
# prefisso lm_studio/ resta perche' e' il dialetto OpenAI-compatible che
# LiteLLM usa per questi endpoint; l'id deve combaciare con quello del YAML.
MODELLO_RAGIONAMENTO=lm_studio/qwen3-8b-gsq
MODELLO_API_KEY=
MODELLO_API_BASE=http://host.docker.internal:1235/v1

# MODELLO ECONOMICO — titoli, classificazione, riscrittura query.
# Puo essere di un provider diverso, o lo stesso modello principale
# all'inizio (poi si abbassa quando l'eval dice che regge).
MODELLO_VELOCE=
MODELLO_VELOCE_API_KEY=
MODELLO_VELOCE_API_BASE=

# ---- Utenti di prova del realm (solo sviluppo) ------------------------
# Rimuovere gli utenti prova.* dal realm prima della produzione.
TEST_USER_PASSWORD=

# ---- Connettori ai gestionali (SPECIFICA-CONNETTORI.md, decisioni 69-70) --
# Ogni azienda ha il suo connettore al gestionale. I COLLEGAMENTI (server,
# database, credenziali) li crea il Superutente dal pannello: le credenziali
# sono cifrate nel database con CHIAVE_CREDENZIALI, che sta solo qui e la
# possiede solo il servizio `connettori`.
CHIAVE_CREDENZIALI=                    # openssl rand -base64 32
CHIAVE_CREDENZIALI_PRECEDENTE=         # per la rotazione, di solito vuota
CONNETTORI_KEY=                        # segreto condiviso pannello <-> servizio connettori: openssl rand -hex 32

# Scheduler ponte (prima di Dagster): il servizio connettori esegue in
# background le importazioni dovute secondo le frequenze (pianificazioni).
SCHEDULER_INTERVALLO=60                # secondi fra un controllo e l'altro
# SCHEDULER_OFF=1                       # disattiva lo scheduler (per Dagster o per l'avvio a mano)

# UI di Dagster (importazioni programmate, decisione 60): collegamento
# "Gestione importazioni" nel pannello. Dietro SSO aziendale (oauth2-proxy).
DAGSTER_URL=https://dagster.localhost
# Monitoraggio dei sistemi (Uptime Kuma): collegamento "Monitoraggio sistemi".
UPTIME_URL=https://uptime.localhost
# UI dei modelli AI (LiteLLM): collegamento "Modelli AI". /ui = dashboard
# (la radice di LiteLLM e' l'elenco delle API).
LITELLM_URL=https://modelli.localhost/ui
# Login della UI di LiteLLM (credenziali dedicate; l'SSO della UI e' un passo
# successivo). Se UI_PASSWORD e' vuota, LiteLLM accetta la master key.
UI_USERNAME=admin
UI_PASSWORD=
# SSO della UI di LiteLLM (generic OIDC verso Keycloak): client `litellm-sso`.
GENERIC_CLIENT_SECRET=                  # openssl rand -hex 32
GENERIC_CLIENT_STATE=                   # openssl rand -hex 16
# Azioni sui servizi (riavvio/stop, whitelist + registro): chiave condivisa
# pannello <-> servizio azioni.
AZIONI_KEY=                            # openssl rand -hex 32
# oauth2-proxy: client Keycloak per l'SSO degli strumenti esterni.
OAUTH2_PROXY_CLIENT_SECRET=            # openssl rand -hex 32
OAUTH2_PROXY_COOKIE_SECRET=            # openssl rand -base64 32
OAUTH2_PROXY_UPTIME_CLIENT_SECRET=     # openssl rand -hex 32
OAUTH2_PROXY_IMMAGINI_CLIENT_SECRET=   # openssl rand -hex 32 (sessione delle immagini)
OAUTH2_PROXY_UPTIME_COOKIE_SECRET=     # openssl rand -base64 32
# Il cookie secret va in base64 URL-safe: con un '+' o uno '/' dentro
# oauth2-proxy non lo decodifica, lo conta come 44 byte e non parte.
#   openssl rand -base64 32 | tr '+/' '-_'
OAUTH2_PROXY_IMMAGINI_COOKIE_SECRET=
OAUTH2_PROXY_LITELLM_CLIENT_SECRET=    # openssl rand -hex 32
OAUTH2_PROXY_LITELLM_COOKIE_SECRET=    # openssl rand -base64 32

# SOLO per la CLI prima del pannello (py -m connettori.esegui): credenziali in
# chiaro su .env. Col pannello non servono. L'utente DEVE essere di sola lettura.
# CONNETTORE_INTEGRA_HOST=192.168.1.41
# CONNETTORE_INTEGRA_PORTA=5432
# Il gestionale si legge dal DB parallelo "rag" (postgres_fdw verso Integra),
# dove stanno le viste rag_*: il connettore punta li', non al gestionale.
# CONNETTORE_INTEGRA_DATABASE=rag
# CONNETTORE_INTEGRA_UTENTE=assistente_ro
# CONNETTORE_INTEGRA_PASSWORD=
# CONNETTORE_INTEGRA_SSL=preferita

# ======================================================================
# PERSONALIZZAZIONE CLIENTE
# Tutto cio' che cambia da un cliente all'altro sta qui. Il logo e la
# favicon si sostituiscono in branding/, che viene montata sopra gli asset.
# Nuovo cliente = questi valori + due file in branding/.
# ======================================================================
NOME_AZIENDA=Azienda Esempio S.p.A.
NOME_ASSISTENTE=Assistente Aziendale
MESSAGGIO_BENVENUTO=Ciao {{user.name}}, chiedimi qualcosa sui documenti aziendali.
PIE_DI_PAGINA=Assistente interno — le risposte vanno sempre verificate sulle fonti citate.

TITOLO_DISCLAIMER=Condizioni d'uso
# Accettazione obbligatoria al primo accesso. Una riga per capoverso.
TESTO_DISCLAIMER=Questo assistente risponde solo sui documenti aziendali a cui hai accesso. Le risposte possono contenere errori: verifica sempre la fonte citata prima di usarle. Le conversazioni sono registrate per finalita di miglioramento del servizio e non lasciano l'azienda.
URL_DISCLAIMER=
URL_PRIVACY=
