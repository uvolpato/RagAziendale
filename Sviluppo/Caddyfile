# Unico punto esposto. Orchestratore, Postgres e Mongo restano sulla rete interna.

{$APP_HOST} {
	# tls internal = CA locale di Caddy: va distribuito il root cert ai client.
	# In azienda, sostituisci con il certificato interno:
	#   tls /etc/caddy/cert.pem /etc/caddy/key.pem
	tls internal

	# ------------------------------------------------------------------
	# /login non deve MAI essere servita.
	#
	# Risolve due problemi con una regola:
	#
	# 1. LA PAGINA CHE LAMPEGGIA. OPENID_AUTO_REDIRECT agisce lato client:
	#    il browser scarica la SPA, la disegna, si accorge che non c'e'
	#    sessione e solo allora salta a Keycloak. Quel mezzo secondo di
	#    pagina intravista e' la pagina di login di LibreChat. Intercettando
	#    qui, il browser riceve un 302 e non disegna nulla.
	#
	# 2. IL LOGOUT CHE NON DISCONNETTE. Il pulsante chiude la sessione di
	#    LibreChat e porta a /login; se da qui si andasse direttamente a
	#    /oauth/openid, Keycloak riconoscerebbe la sua sessione SSO ancora
	#    aperta ed emetterebbe un nuovo codice senza chiedere niente —
	#    l'utente rientrerebbe in chat. Passando invece dall'
	#    end_session_endpoint, la sessione SSO viene chiusa e solo dopo si
	#    riparte dall'autenticazione, che ora chiede le credenziali.
	#
	# COSTO DA CONOSCERE: chi arriva senza sessione LibreChat ma con una
	# sessione SSO valida aperta da un'ALTRA applicazione aziendale viene
	# disconnesso anche da quella. Accettabile con una sola applicazione;
	# da rivedere il giorno che il SSO serve piu' applicazioni — in quel
	# caso si distinguono i due casi con un parametro sul logout.
	@login path /login /login/*
	redir @login https://{$SSO_HOST}/realms/{$REALM}/protocol/openid-connect/logout?client_id=librechat&post_logout_redirect_uri=https%3A%2F%2F{$APP_HOST}%2Foauth%2Fopenid 302

	# ------------------------------------------------------------------
	# Il login non atterra piu' sulla radice, ma su /c/new.
	#
	# Serve a spezzare il ciclo: con l'atterraggio su / e un redirect sulla
	# radice, la sequenza sarebbe / -> Keycloak -> callback -> / -> Keycloak
	# senza fine. Spostando l'atterraggio su un percorso diverso, la catena
	# termina sempre.
	#
	# Un primo tentativo condizionava il redirect alla presenza del cookie
	# `refreshToken`. Non funziona: i cookie di LibreChat sono
	# SameSite=Strict e per il browser sso.localhost e assistente.localhost
	# sono siti diversi, quindi su / il cookie puo' non essere inviato e il
	# ciclo si innesca comunque. Lato server non si vedeva: httpx ignora
	# SameSite e i test passavano.
	handle /oauth/openid/callback {
		reverse_proxy librechat:3080 {
			# Senza slash finale: LibreChat manda "https://host", non
			# "https://host/". Nessun gruppo di cattura, cosi non si
			# dipende dalla sintassi di sostituzione di Caddy.
			# Dopo il login si passa dal portale (decisione 55): gli operatori
			# ricevono un 302 immediato verso /c/new, gli amministratori vedono
			# la scelta Chat / Amministrazione. Percorso diverso da /: la catena
			# di redirect termina sempre.
			header_down Location "^https?://{$APP_HOST}/?$" "https://{$APP_HOST}/amministrazione/dopo-login"
		}
	}

	# ------------------------------------------------------------------
	# La radice non serve mai una pagina: 302 incondizionato.
	#
	# Chi non ha sessione finisce sul form di Keycloak senza che il browser
	# disegni nulla — la schermata di benvenuto non compare.
	# Chi ce l'ha fa un giro SSO silenzioso (~200ms, nessuna pagina
	# disegnata) e atterra su /c/new. Nessun cookie da controllare, quindi
	# nessuna dipendenza da SameSite e nessun ciclo possibile.
	redir / /oauth/openid 302

	# Portale e amministrazione: servizio separato (decisione 58).
	handle /amministrazione* {
		reverse_proxy amministrazione:8000
	}

	# Immagini dei documenti (cataloghi): DIETRO SESSIONE. Un tag <img> non
	# manda identita', solo i cookie: oauth2-proxy autentica con Keycloak e
	# passa i gruppi all'orchestratore, che ricontrolla le ACL immagine per
	# immagine. L'URL firmato resta come seconda serratura (il gate lo emette
	# solo per i chunk gia' ammessi, ed e' legato alla persona).
	handle /immagini* {
		reverse_proxy oauth2-proxy-immagini:4180
	}

	# Documenti originali, aperti alla pagina citata. STESSA sessione e stesso
	# proxy delle immagini, per la stessa ragione: il browser segue un
	# collegamento senza mandare identita', quindi l'identita' la mette
	# oauth2-proxy e l'orchestratore ricontrolla il permesso sulla fonte.
	# Chi puo' vedere quella fonte puo' aprire quel documento: e' lo stesso
	# permesso che gli fa leggere le risposte che ne vengono.
	handle /documenti* {
		reverse_proxy oauth2-proxy-immagini:4180
	}

	# Ritorno da Keycloak per la sessione delle immagini. Percorso distinto da
	# quello di LibreChat (/oauth/openid/callback): le due sessioni convivono
	# sullo stesso dominio senza toccarsi.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy-immagini:4180
	}

	# ------------------------------------------------------------------
	# Caricamento file in chat BLOCCATO qui, non solo in librechat.yaml
	# (decisione 63). fileConfig.disabled nasconde il pulsante, ma non e'
	# dimostrato che il server lo faccia rispettare: una regola di
	# sicurezza non puo' dipendere da questo. I file caricati finirebbero
	# nella ricerca di LibreChat, che non passa dal gate (niente ACL,
	# residenza, taint).
	# Blocca anche /api/files/speech: quando arrivera' la voce, si apre
	# SOLO quel percorso.
	@caricamenti {
		method POST PUT
		path /api/files /api/files/*
	}
	respond @caricamenti "Caricamento file disattivato" 403

	reverse_proxy librechat:3080
}

{$SSO_HOST} {
	tls internal
	reverse_proxy keycloak:8080
}

# Dagster: UI delle importazioni (decisione 60), dietro SSO aziendale via
# oauth2-proxy + Keycloak (niente password locale). oauth2-proxy fa da reverse
# proxy: autentica con Keycloak e inoltra a Dagster.
dagster.localhost {
	tls internal
	reverse_proxy oauth2-proxy:4180
}

# Uptime Kuma: monitoraggio dei sistemi (decisione 60), SSO come Dagster.
uptime.localhost {
	tls internal
	reverse_proxy oauth2-proxy-uptime:4180
}
