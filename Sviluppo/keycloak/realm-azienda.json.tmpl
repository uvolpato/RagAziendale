{
  "realm": "azienda",
  "enabled": true,
  "displayName": "${NOME_AZIENDA}",
  "loginTheme": "azienda",
  "internationalizationEnabled": true,
  "supportedLocales": ["it", "en", "de"],
  "defaultLocale": "it",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 14400,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 604800,

  "groups": [
    { "name": "tutti",           "path": "/tutti" },
    { "name": "magazzino",       "path": "/magazzino" },
    { "name": "vendite",         "path": "/vendite" },
    { "name": "amministrazione", "path": "/amministrazione" },
    { "name": "direzione",       "path": "/direzione" },
    {
      "name": "amministratori",
      "path": "/amministratori",
      "subGroups": [
        { "name": "Responsabile IT",         "path": "/amministratori/Responsabile IT",
          "clientRoles": { "amministrazione": ["admin-accessi", "admin-sistemi", "admin-anomalie"] } },
        { "name": "Responsabile dati",       "path": "/amministratori/Responsabile dati",
          "clientRoles": { "amministrazione": ["admin-fonti", "admin-importazioni", "admin-anomalie"] } },
        { "name": "Amministratore completo", "path": "/amministratori/Amministratore completo",
          "clientRoles": { "amministrazione": ["admin-accessi", "admin-fonti", "admin-importazioni",
                                               "admin-anomalie", "admin-sistemi", "admin-ruoli"] } },
        { "name": "Revisore DPO",            "path": "/amministratori/Revisore DPO",
          "clientRoles": { "amministrazione": ["admin-revisore"] } }
      ]
    }
  ],

  "roles": {
    "client": {
      "amministrazione": [
        { "name": "admin-accessi", "description": "Gestione accessi: utenti, gruppi operativi, aziende abilitate. Non assegna ruoli di amministrazione. Permessi dati dalle deleghe (keycloak/deleghe.py), NON da ruoli di realm-management, che le scavalcherebbero" },
        { "name": "admin-fonti", "description": "Gestione fonti: chi vede cosa, aziende, uso di servizi esterni" },
        { "name": "admin-importazioni", "description": "Gestione importazioni dai gestionali e dei documenti" },
        { "name": "admin-anomalie", "description": "Gestione anomalie: presa in carico, assegnazione, risoluzione" },
        { "name": "admin-sistemi", "description": "Gestione sistemi: monitoraggio, aspetto" },
        { "name": "admin-ruoli", "description": "Gestione amministratori: assegna ruoli e profili di amministrazione",
          "composite": true, "composites": { "client": { "realm-management": ["view-users", "manage-users", "query-users", "query-groups", "view-clients", "query-clients"] } } },
        { "name": "admin-revisore", "description": "Revisore: sola lettura su tutto, compresi eventi e configurazione",
          "composite": true, "composites": { "client": { "realm-management": ["view-users", "query-users", "query-groups", "view-events", "view-realm", "view-clients"] } } }
      ]
    }
  },

  "defaultGroups": ["/tutti"],

  "clients": [
    {
      "clientId": "librechat",
      "name": "LibreChat",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OPENID_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://${APP_HOST}/oauth/openid/callback",
        "https://${APP_HOST}/*"
      ],
      "webOrigins": ["https://${APP_HOST}"],
      "attributes": {
        "post.logout.redirect.uris": "https://${APP_HOST}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-orchestratore",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orchestratore",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "orchestratore",
      "name": "Orchestratore",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false
    },
    {
      "clientId": "amministrazione",
      "name": "Amministrazione",
      "description": "Possiede i ruoli admin-*. Diventera il client del portale di amministrazione",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false
    },
    {
      "clientId": "test-token",
      "name": "SOLO SVILUPPO - ottenere token via password grant",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "audience-orchestratore",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orchestratore",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "prova.magazzino",
      "email": "prova.magazzino@esempio.local",
      "firstName": "Prova",
      "lastName": "Magazzino",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-azienda"],
      "groups": ["/tutti", "/magazzino"],
      "credentials": [
        { "type": "password", "value": "${TEST_USER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "prova.vendite",
      "email": "prova.vendite@esempio.local",
      "firstName": "Prova",
      "lastName": "Vendite",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-azienda"],
      "groups": ["/tutti", "/vendite"],
      "credentials": [
        { "type": "password", "value": "${TEST_USER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "prova.direzione",
      "email": "prova.direzione@esempio.local",
      "firstName": "Prova",
      "lastName": "Direzione",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-azienda"],
      "groups": ["/tutti", "/vendite", "/amministrazione", "/direzione"],
      "credentials": [
        { "type": "password", "value": "${TEST_USER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "prova.admin",
      "email": "prova.admin@esempio.local",
      "firstName": "Prova",
      "lastName": "Amministratore",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-azienda"],
      "groups": ["/tutti", "/amministratori/Amministratore completo"],
      "credentials": [
        { "type": "password", "value": "${TEST_USER_PASSWORD}", "temporary": false }
      ]
    },
    {
      "username": "prova.accessi",
      "email": "prova.accessi@esempio.local",
      "firstName": "Prova",
      "lastName": "Accessi",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-azienda"],
      "groups": ["/tutti"],
      "clientRoles": { "amministrazione": ["admin-accessi"] },
      "credentials": [
        { "type": "password", "value": "${TEST_USER_PASSWORD}", "temporary": false }
      ]
    }
  ]
}
