{
  "realm": "azienda",
  "enabled": true,
  "displayName": "${NOME_AZIENDA}",
  "loginTheme": "azienda",
  "internationalizationEnabled": true,
  "supportedLocales": ["it", "en", "de"],
  "defaultLocale": "it",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 14400,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 604800,

  "groups": [
    { "name": "tutti",           "path": "/tutti" },
    { "name": "magazzino",       "path": "/magazzino" },
    { "name": "vendite",         "path": "/vendite" },
    { "name": "amministrazione", "path": "/amministrazione" },
    { "name": "direzione",       "path": "/direzione" },
    { "name": "acquisti",        "path": "/acquisti" },
    { "name": "sicurezza",       "path": "/sicurezza",
      "attributes": { "descrizione": ["Addetti alla sicurezza: vedono e depositano i documenti della cartella Sicurezza"] } },
    { "name": "sicurezza-gestori", "path": "/sicurezza-gestori",
      "attributes": { "descrizione": ["Gestiscono la cartella Sicurezza e aggiungono i colleghi al gruppo sicurezza (amministrazione/gestori.py)"] },
      "clientRoles": { "amministrazione": ["gestore-gruppo"] } },
    { "name": "azienda-luis",       "path": "/azienda-luis",
      "attributes": { "descrizione": ["Abilita ai dati di Luis S.r.l. (asse azienda, decisione 53)"] } },
    { "name": "azienda-decobrands", "path": "/azienda-decobrands",
      "attributes": { "descrizione": ["Abilita ai dati di Decobrands (asse azienda, decisione 53)"] } },
    {
      "name": "amministratori",
      "path": "/amministratori",
      "subGroups": [
        { "name": "Responsabile IT",         "path": "/amministratori/Responsabile IT",
          "clientRoles": { "amministrazione": ["admin-accessi", "admin-sistemi", "admin-anomalie"] } },
        { "name": "Responsabile dati",       "path": "/amministratori/Responsabile dati",
          "clientRoles": { "amministrazione": ["admin-fonti", "admin-importazioni", "admin-anomalie"] } },
        { "name": "Amministratore completo", "path": "/amministratori/Amministratore completo",
          "clientRoles": { "amministrazione": ["admin-accessi", "admin-fonti", "admin-importazioni",
                                               "admin-anomalie", "admin-sistemi", "admin-ruoli"] } },
        { "name": "Gestione accessi",        "path": "/amministratori/Gestione accessi",
          "clientRoles": { "amministrazione": ["admin-accessi"] } },
        { "name": "Revisore DPO",            "path": "/amministratori/Revisore DPO",
          "clientRoles": { "amministrazione": ["admin-revisore"] } },
        { "name": "Superutente",             "path": "/amministratori/Superutente",
          "clientRoles": { "amministrazione": ["admin-super"] } }
      ]
    }
  ],

  "roles": {
    "client": {
      "amministrazione": [
        { "name": "admin-accessi", "description": "Gestione accessi: crea operatori, gruppi operativi, aziende abilitate, password degli operatori. Non tocca gli amministratori. Permessi dalle deleghe (keycloak/deleghe.py), MAI da ruoli di realm-management: anche uno solo farebbe saltare le deleghe a chi lo somma ad altri ruoli" },
        { "name": "admin-fonti", "description": "Gestione fonti: chi vede cosa, aziende, uso di servizi esterni. Legge utenti e gruppi. Permessi dalle deleghe (keycloak/deleghe.py), MAI da ruoli di realm-management: anche uno solo farebbe saltare le deleghe a chi lo somma ad altri ruoli" },
        { "name": "admin-importazioni", "description": "Gestione importazioni dai gestionali e dei documenti. Permessi dalle deleghe (keycloak/deleghe.py), MAI da ruoli di realm-management: anche uno solo farebbe saltare le deleghe a chi lo somma ad altri ruoli" },
        { "name": "admin-anomalie", "description": "Gestione anomalie: presa in carico, assegnazione, risoluzione. Permessi dalle deleghe (keycloak/deleghe.py), MAI da ruoli di realm-management: anche uno solo farebbe saltare le deleghe a chi lo somma ad altri ruoli" },
        { "name": "admin-sistemi", "description": "Gestione sistemi: monitoraggio, aspetto. Permessi dalle deleghe (keycloak/deleghe.py), MAI da ruoli di realm-management: anche uno solo farebbe saltare le deleghe a chi lo somma ad altri ruoli" },
        { "name": "admin-ruoli", "description": "Gestione amministratori: assegna i profili di amministrazione, tranne Superutente. Permessi dalle deleghe (keycloak/deleghe.py), MAI da ruoli di realm-management: anche uno solo farebbe saltare le deleghe a chi lo somma ad altri ruoli" },
        { "name": "admin-revisore", "description": "Revisore: sola lettura su tutto. Permessi dalle deleghe (keycloak/deleghe.py), MAI da ruoli di realm-management: anche uno solo farebbe saltare le deleghe a chi lo somma ad altri ruoli" },
        { "name": "gestore-gruppo", "description": "Gestore di un gruppo: aggiunge e toglie i colleghi del SUO gruppo (chi sta in <nome>-gestori gestisce <nome>). Permessi dalle deleghe (amministrazione/gestori.py). Si ha solo dal gruppo -gestori, mai assegnato direttamente" },
        { "name": "admin-super", "description": "Superutente: vede e modifica tutto, tutte le aziende, compresa la composizione dei profili. Unico ruolo con i ruoli classici di Keycloak (realm-admin). Si assegna solo da un altro Superutente o dall'amministratore tecnico.",
          "composite": true, "composites": { "client": { "realm-management": ["realm-admin"] } } }
      ]
    }
  },

  "defaultGroups": ["/tutti"],

  "clients": [
    {
      "clientId": "librechat",
      "name": "LibreChat",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OPENID_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://${APP_HOST}/oauth/openid/callback",
        "https://${APP_HOST}/*"
      ],
      "webOrigins": ["https://${APP_HOST}"],
      "attributes": {
        "post.logout.redirect.uris": "https://${APP_HOST}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-orchestratore",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orchestratore",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "orchestratore",
      "name": "Orchestratore",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false
    },
    {
      "clientId": "amministrazione",
      "name": "Amministrazione",
      "description": "Portale dopo il login e amministrazione. Possiede i ruoli admin-*. Pubblico con PKCE: il servizio non custodisce segreti (decisione 58)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://${APP_HOST}/amministrazione/oidc/callback"],
      "webOrigins": ["https://${APP_HOST}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${APP_HOST}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": { "claim.name": "groups", "full.path": "false",
                      "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "dagster",
      "name": "Dagster (UI importazioni)",
      "description": "Accesso alla UI di Dagster via oauth2-proxy. Solo amministratori (gruppo /amministratori).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OAUTH2_PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://dagster.localhost/oauth2/callback"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "uptime",
      "name": "Uptime Kuma (monitoraggio)",
      "description": "Accesso al monitoraggio dei sistemi via oauth2-proxy. Solo amministratori.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OAUTH2_PROXY_UPTIME_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://uptime.localhost/oauth2/callback"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "litellm",
      "name": "LiteLLM (modelli AI)",
      "description": "Accesso alla UI di LiteLLM via oauth2-proxy. Solo amministratori.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OAUTH2_PROXY_LITELLM_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://modelli.localhost/oauth2/callback"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "litellm-sso",
      "name": "LiteLLM SSO (UI)",
      "description": "SSO della UI di LiteLLM: generic OIDC verso Keycloak.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${GENERIC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://modelli.localhost/sso/callback"]
    },
    {
      "clientId": "test-token",
      "name": "SOLO SVILUPPO - ottenere token via password grant",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "audience-orchestratore",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orchestratore",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

